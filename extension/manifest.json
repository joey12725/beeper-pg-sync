{
  "manifest_version": 3,
  "name": "Instagram Chat Exporter",
  "version": "1.0.5",
  "description": "Export Instagram conversations locally as text, Markdown, CSV or a ZIP of chats.",
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
